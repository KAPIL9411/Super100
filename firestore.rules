rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /users/{userId} {
      // Users can read/write their own data
      // Admins can read all users data
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /examHistory/{document} {
        // Users can read/write their own data
        // Admins can read all users' exam history
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /examAttempts/{document} {
        // Users can read/write their own data
        // Admins can read all users' exam attempts
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /bookmarkedQuestions/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /customSheets/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /issueReports/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /activeTest/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /mockPlanner/{document} {
        // Users can read/write their own mock plans
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
